[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/view/main_menu.gd" id="1_menu"]
[ext_resource type="PackedScene" path="res://scenes/ui/menu_button.tscn" id="2_button"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.11, 0.13, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Title" type="Label" parent="Center/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.94, 0.9, 1)
theme_override_font_sizes/font_size = 96
text = "Project Bebop"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.76, 0.72, 1)
theme_override_font_sizes/font_size = 36
text = "Terraforming 4X"
horizontal_alignment = 1

[node name="NewGameButton" parent="Center/Column" instance=ExtResource("2_button")]
unique_name_in_owner = true
layout_mode = 2
text = "New Game"

[connection signal="pressed" from="Center/Column/NewGameButton" to="." method="_on_new_game_pressed"]
