data_*/
mono_crash.*.json

# System/tool-specific ignores
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Build outputs
builds/
*.x86_64
*.exe
*.app
*.zip

# Logs
logs/*.json
*.log
